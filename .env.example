# Copy this file to .env and fill in the values.
# The .env file is ignored by git.

# Your adventofcode.com session cookie.
# Open the site, log in, open the browser dev tools and copy the "session" cookie value.
AOC_SESSION=

# Advent of Code asks that automated requests identify the user.
# Put a way to contact you here, for example a GitHub repository URL or an email address.
AOC_USER_AGENT="github.com/<you>/advent-of-code by <you@example.com>"
